<?xml version="1.0" encoding="utf-8"?>
<!--
  960 x 540 dp canvas, 48 dp edge rule. The focused app's featured art fills the screen;
  the sidebar (added in code) floats top-left; rows sit on the deep bottom scrim.
    28   sidebar capsule (time), opens into the glass panel
   236   dock banners 160x90 (26 dp clear above the heading)
   352   "Jatka katsomista"
   396   cards 148x83; a focused card (scaled + lifted) still clears the heading by 12 dp;
         title + subtitle under each (always visible)
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipChildren="false"
    android:clipToPadding="false">

    <fi.koti.launcher.BackdropView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <FrameLayout
        android:id="@+id/stage"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:clipToPadding="false">

        <LinearLayout
            android:id="@+id/dock"
            android:layout_width="wrap_content"
            android:layout_height="90dp"
            android:layout_gravity="center_horizontal|top"
            android:layout_marginTop="236dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:orientation="horizontal" />

        <TextView
            android:id="@+id/continue_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="48dp"
            android:layout_marginTop="352dp"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/continue_watching"
            android:textColor="#FFF5F5F7"
            android:textSize="20sp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/continue_row"
            android:layout_width="match_parent"
            android:layout_height="150dp"
            android:layout_marginTop="388dp"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingStart="48dp"
            android:paddingTop="8dp"
            android:paddingEnd="48dp" />
    </FrameLayout>

    <FrameLayout
        android:id="@+id/sidebar_host"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false" />

    <FrameLayout
        android:id="@+id/overlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipChildren="false"
        android:visibility="gone" />
</FrameLayout>
