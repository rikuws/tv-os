<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Koti" parent="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/sky_top</item>
        <item name="android:colorBackground">@color/sky_top</item>
        <item name="android:windowShowWallpaper">false</item>
        <item name="android:windowAnimationStyle">@null</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <!-- Deeper focus shadows, so lifted cards float like tvOS lockups -->
        <item name="android:ambientShadowAlpha">0.16</item>
        <item name="android:spotShadowAlpha">0.42</item>
    </style>
</resources>
